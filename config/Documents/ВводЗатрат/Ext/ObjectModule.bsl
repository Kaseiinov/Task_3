Процедура ПередЗаписью(Отказ)	Если РольДоступна("Шейх") Тогда		Возврат;	КонецЕсли;                                                     	Если Дата < НачалоДня(ТекущаяДата()) Тогда		Сообщить("Нельзя редактировать документы прошлых дней");		Отказ = Истина;		Возврат;	КонецЕсли;	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();	Для Каждого Строка Из Расходы Цикл		Если Строка.Статья.Ответственный.Наименование <> ТекущийПользователь.Имя Тогда
			Сообщить("Статья «" + Строка.Статья + "» закреплена за другим пользователем");			Отказ = Истина;			Возврат;		КонецЕсли;	КонецЦикла;КонецПроцедуры       

Процедура ОбработкаПроведения(Отказ, РежимПроведения)	Движения.РасходыПоСтатьям.Записывать = Истина;	Для Каждого Строка Из Расходы Цикл		Движение = Движения.РасходыПоСтатьям.Добавить();		Движение.Период = Дата;		Движение.Статья = Строка.Статья;		Движение.Сумма = Строка.Сумма;	КонецЦикла;КонецПроцедуры